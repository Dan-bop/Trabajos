<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="3.0"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

  <persistence-unit name="ComercialMaysuPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

    <class>modelo.Carrito</class>
    <class>modelo.Cliente</class>
    <class>modelo.Contacto</class>
    <class>modelo.Contenido</class>
    <class>modelo.DetalleCarrito</class>
    <class>modelo.DetallePedido</class>
    <class>modelo.Pago</class>
    <class>modelo.Pedido</class>
    <class>modelo.Producto</class>
    <class>modelo.UsuarioAdmin</class>

    <!--   Mysql Conexion   -->
    <properties>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/comercial_maysu"/>
      <property name="jakarta.persistence.jdbc.user" value="root"/>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.password" value="soporte"/>

      <!--   JPA Reglas   -->
      <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
      <property name="eclipselink.logging.level" value="FINE"/>
    </properties>
  </persistence-unit>
</persistence>
