<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Resumen de compra - Comercial Maysu</title>
  <link rel="stylesheet" href="estilos.css">
</head>
<body>

  <!-- Encabezado -->
  <header>
    <h1>Comercial Maysu</h1>
    <nav>
      <a href="home">Inicio</a> |
      <a href="catalogo">Catálogo</a> |
      <a href="carrito">Carrito</a> |
      <a href="login">Iniciar sesión</a>
    </nav>
  </header>

  <!-- Resumen -->
  <main>
    <h2>Resumen de tu pedido</h2>
    <c:if test="${carrito == null || carrito.isEmpty()}">
      <p>No hay productos en el carrito.</p>
    </c:if>

    <c:if test="${not empty carrito}">
      <table>
        <tr>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>Precio unitario</th>
          <th>Subtotal</th>
        </tr>
        <c:set var="total" value="0" />
        <c:forEach var="item" items="${carrito}">
          <tr>
            <td>${item.producto.nombre}</td>
            <td>${item.cantidad}</td>
            <td>S/. ${item.precioUnitario}</td>
            <td>S/. ${item.subtotal}</td>
          </tr>
          <c:set var="total" value="${total + item.subtotal}" />
        </c:forEach>
        <tr>
          <td colspan="3"><strong>Total a pagar:</strong></td>
          <td><strong>S/. ${total}</strong></td>
        </tr>
      </table>

      <form action="confirmarPedido" method="post">
        <button type="submit">Confirmar compra</button>
      </form>
    </c:if>
  </main>

  <!-- Footer -->
  <footer>
    <p>© 2025 Comercial Maysu — Todos los derechos reservados</p>
    <p>
      <a href="contacto">Contacto</a> |
      <a href="info">Políticas</a> |
      Síguenos en Facebook, Instagram, WhatsApp
    </p>
  </footer>

</body>
</html>
