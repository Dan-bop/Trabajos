<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Comercial Maysu - Inicio</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>

  <!-- 🧭 Encabezado -->
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
      <a class="navbar-brand" href="home">🛒 Comercial Maysu</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="catalogo">Catálogo</a></li>
          <li class="nav-item"><a class="nav-link" href="carrito">Carrito</a></li>
          <li class="nav-item"><a class="nav-link" href="login">Iniciar sesión</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- 🖼️ Banner promocional -->
  <div class="container mt-4">
    <div class="p-4 mb-4 bg-warning text-dark rounded text-center">
      <h3>¡Bienvenido a Comercial Maysu!</h3>
      <p>Ofertas especiales en abarrotes por tiempo limitado. ¡Aprovecha ahora!</p>
      <a href="catalogo" class="btn btn-dark">Ver catálogo completo</a>
    </div>
  </div>

  <!-- 🌟 Productos destacados -->
  <div class="container">
    <h4 class="mb-3">Productos destacados</h4>
    <div class="row">
      <c:forEach var="p" items="${destacados}">
        <div class="col-md-3 mb-4">
          <div class="card h-100">
            <img src="img/productos/${p.imagen}" class="card-img-top" alt="${p.nombre}">
            <div class="card-body">
              <h5 class="card-title">${p.nombre}</h5>
              <p class="card-text">S/. ${p.precio}</p>
              <a href="detalle?id=${p.id}" class="btn btn-primary">Ver más</a>
            </div>
          </div>
        </div>
      </c:forEach>
      <c:if test="${fn:length(destacados) == 0}">
        <p class="text-muted">No hay productos destacados en este momento.</p>
      </c:if>
    </div>
  </div>

  <!-- 📦 Footer institucional -->
  <footer class="bg-light text-center text-lg-start mt-5">
    <div class="container p-4">
      <div class="row">
        <div class="col-lg-6 col-md-12 mb-4">
          <h5 class="text-uppercase">Sobre nosotros</h5>
          <p>
            Comercial Maysu es tu tienda de abarrotes confiable. Ofrecemos productos de calidad a precios accesibles.
          </p>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
          <h5 class="text-uppercase">Enlaces útiles</h5>
          <ul class="list-unstyled mb-0">
            <li><a href="catalogo" class="text-dark">Catálogo</a></li>
            <li><a href="contacto" class="text-dark">Contacto</a></li>
            <li><a href="info" class="text-dark">Políticas</a></li>
          </ul>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
          <h5 class="text-uppercase">Síguenos</h5>
          <ul class="list-unstyled mb-0">
            <li><a href="#" class="text-dark">Facebook</a></li>
            <li><a href="#" class="text-dark">Instagram</a></li>
            <li><a href="#" class="text-dark">WhatsApp</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="text-center p-3 bg-dark text-white">
      © 2025 Comercial Maysu — Todos los derechos reservados
    </div>
  </footer>

</body>
</html>
